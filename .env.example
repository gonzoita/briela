# Plantilla de configuración de una instalación de Briela.
#
# El asistente de instalación (/instalar) genera el .env a partir de esta
# plantilla. Al editarla, recordar que la va a leer el servidor de un cliente:
# nada de valores propios de Briela ni de otra instalación.

APP_NAME=Briela
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# En producción la sesión va en base de datos.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── Licencia ───────────────────────────────────────────────────────────────
# Serial entregado por Briela. Se pide en el asistente de instalación y se
# valida contra el servidor de licencias. Ver docs/BRIELA-PLAN.md sección 4.
BRIELA_SERIAL=
BRIELA_LICENCIA_URL=https://superadmin.briela.app

# ─── IA ─────────────────────────────────────────────────────────────────────
# La llave de OpenRouter NO va en la instalación: el asistente sale por el proxy
# del superadmin, que valida el serial y mide el consumo. Ver sección 5 del plan.
BRIELA_IA_URL=https://superadmin.briela.app/api/ia

# Tener serial manda: con serial se sale siempre por el proxy, y esta llave se
# ignora. Existe solo para desarrollar sin superadmin levantado, y en la
# instalación de un cliente debe quedar vacía.
OPENROUTER_API_KEY=

# Modelos por omisión. Se pueden cambiar desde Ajustes sin tocar este archivo.
OPENROUTER_MODELO_TEXTO=anthropic/claude-sonnet-5
OPENROUTER_MODELO_IMAGEN=openai/gpt-image-2

# ─── WhatsApp Cloud API (Meta) — opcional, por cliente ──────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=

# ─── Redes sociales — opcional, por cliente ─────────────────────────────────
# Los REDIRECT_URI se arman con el dominio de ESTA instalación, no con uno fijo.
# Ejemplo: https://midominio.com/rrss/cuentas/callback/meta
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

GOOGLE_RRSS_CLIENT_ID=
GOOGLE_RRSS_CLIENT_SECRET=
GOOGLE_RRSS_REDIRECT_URI=
